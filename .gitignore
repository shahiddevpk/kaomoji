# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit .env.example only)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research packs - never commit
uploads/
kaomoji-research/
research/
*.zip

# local agent / one-off scratch - never commit
scripts/_*
scripts/_*/
*.local.ts
*.local.js
*.local.cjs
*.local.mjs

# editor / OS junk
Thumbs.db
Desktop.ini
*.swp
*~

# optional local tooling caches
.turbo/
.idea/
.vscode/
!.vscode/extensions.json

# Lighthouse / lab perf artifacts (local only)
/lh-out/
*.report.html
*.report.json

# local Chrome / Lighthouse TMP spills inside the repo
/tmp-lh/
/.lighthouseci/
**/node-compile-cache/

# throwaway QA / agent smoke scratch at repo root
.qa-*
.qa-*/

# duplicate / experimental modules at repo root (real code is under components/)
/_head_*.tsx
_head_*.tsx

# one-off Python dump/patch helpers under lh-out (also covered by /lh-out/)
kaomoji-dump.py
kaomoji-fix-header.py
kaomoji-patch*.py
kaomoji-verify.py

# local start / agent logs
start-*.log
start-*.err
*.local.log
# SEO audit / agent scratch dumps (local only)
_seo-audit-tmp/

# SEO re-review / residual audit scratch (local only)
_seo_rereview/
_seo_*/
# agent residual inspect / curl helpers (local only)
inspect-*.js
curl-leads.js

# agent one-off patch/count helpers at repo root (local only)
_tmp_*.js
_tmp_*.mjs
_tmp_*.cjs
_tmp_*.ts
patch-*.js
verify-*.js

# root audit / SEO throwaways (local only)
_audit_*.js
_audit_*.mjs
_audit_*.cjs
_audit_*.ts
_seo-*.js
_seo-*.mjs
_seo-*.cjs
_seo-*.ts
_seo-*.html
_seo-*.json
agent-tools/
**/agent-tools/

# Cursor IDE machine-local state (rules under .cursor/rules may still be committed)
.cursor/projects/

# QA flash/debug scratch
_qa_*
_qa_*/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research packs - never commit
uploads/
kaomoji-research/
research/
*.zip

# local agent / one-off scratch - never commit
scripts/_*
scripts/_*/
*.local.ts
*.local.js
*.local.cjs
*.local.mjs

# editor / OS junk
Thumbs.db
Desktop.ini
*.swp
*~

# optional local tooling caches
.turbo/
.idea/
.vscode/
!.vscode/extensions.json

# Lighthouse / lab perf artifacts (local only)
/lh-out/
*.report.html
*.report.json

# local Chrome / Lighthouse TMP spills inside the repo
/tmp-lh/
/.lighthouseci/
**/node-compile-cache/

# throwaway QA / agent smoke scratch at repo root
.qa-*
.qa-*/

# one-off Python dump/patch helpers under lh-out (also covered by /lh-out/)
kaomoji-dump.py
kaomoji-fix-header.py
kaomoji-patch*.py
kaomoji-verify.py

# local start / agent logs
start-*.log
start-*.err
*.local.log
